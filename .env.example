# Copia este archivo como .env y ajusta los valores. Todos son opcionales.

# Enlace público FIJO (el QR nunca cambia): túnel con nombre de Cloudflare en un dominio de la empresa.
# Créalo en Cloudflare Zero Trust > Networks > Tunnels, apuntando a http://localhost:3000, y copia su token.
# Sin estas dos líneas se usa un enlace temporal https://xxxx.trycloudflare.com que cambia al reiniciar.
# CLOUDFLARE_TUNNEL_TOKEN=
# URL_PUBLICA_FIJA=https://pausas.tuempresa.com

# Puerto del servidor web
PORT=3000

# Ubicación de la base de datos SQLite
# DB_PATH=./data/pausas.db

# Normalmente la cuenta de administrador se crea en la pantalla "Crear cuenta" del panel.
# Solo para instalaciones automatizadas: si la base está vacía, se crea con estos datos.
# ADMIN_EMAIL=
# ADMIN_PASSWORD=

# Si el sistema está detrás de un proxy (nginx, IIS, Render…), para obtener la IP real del colaborador
# TRUST_PROXY=1

# Máximo de registros por minuto desde una misma IP (varias personas comparten la IP del Wi-Fi corporativo)
# LIMITE_REGISTROS_POR_MINUTO_IP=300
