{
    "name": "pausas-activas-qr",
    "version": "1.0.0",
    "private": true,
    "description": "Registro de pausas activas por código QR con dashboard en tiempo real para SST",
    "type": "module",
    "engines": {
        "node": ">=22.13"
    },
    "scripts": {
        "dev": "concurrently -k -n api,web -c green,cyan \"npm:dev:api\" \"npm:dev:web\"",
        "dev:api": "node --disable-warning=ExperimentalWarning --watch-path=server server/index.js",
        "dev:web": "vite",
        "build": "vite build",
        "start": "node --disable-warning=ExperimentalWarning server/index.js",
        "demo": "node --disable-warning=ExperimentalWarning server/seed-demo.js",
        "reiniciar": "node --disable-warning=ExperimentalWarning server/reiniciar-datos.js",
        "test": "node --disable-warning=ExperimentalWarning --test tests/api.test.js",
        "carga": "node tests/carga/carga.js"
    },
    "dependencies": {
        "@libsql/client": "^0.18.0",
        "exceljs": "^4.4.0",
        "express": "^5.3.0",
        "qrcode": "^1.5.4",
        "react": "^19.3.1",
        "react-dom": "^19.3.1",
        "react-router-dom": "^7.18.5",
        "recharts": "^3.10.1"
    },
    "devDependencies": {
        "@tailwindcss/vite": "^4.3.3",
        "@vitejs/plugin-react": "^6.1.2",
        "concurrently": "^10.0.6",
        "tailwindcss": "^4.3.3",
        "vite": "^8.3.5"
    },
    "overrides": {
        "uuid": "^11.1.0"
    }
}
